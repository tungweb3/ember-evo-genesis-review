+function laggingDeployer(deployer,share=0.3){
+ let seed=7;const lag=()=>{seed=(seed*1103515245+12345)&0x7fffffff;return seed/0x7fffffff<share;};
+ const provider=new Proxy(deployer.provider,{get(t,k){
+  const v=t[k];
