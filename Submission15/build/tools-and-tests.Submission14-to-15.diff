+const selectorOf=name=>new ethers.Interface(artifacts[GENESIS].abi).getFunction(name).selector;
+const freshInput=srv=>{
+ const provider=mainnetProvider(srv.url),deployer=new ethers.Wallet(testAuthority(3).privateKey,provider);
+ return {provider,deployer,input:{deployer,revealSigner:testAuthority(1),revealCommit:ethers.id('stale test reveal commit'),cfg:MAINNET,timing:FAST_HTTP}};
+};
+// a gateway delivers the transaction, loses the reply, retries, and passes on the "no" to its own copy
+const deliveredThenRefused=(provider,selector,word,code,before=()=>{},after=async()=>{})=>{
+ const real=provider.broadcastTransaction.bind(provider),hashes=[];let left=1;
+ provider.broadcastTransaction=async signed=>{
+  const t=ethers.Transaction.from(signed);
+  if((t.data??'').startsWith(selector)&&before(t)!==false&&left-->0){await real(signed);hashes.push(t.hash);await after();throw Object.assign(Error(word),{code});}
+  return real(signed);
+ };
+ return hashes;
+};
